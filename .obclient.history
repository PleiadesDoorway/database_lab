-- echo hash join
### 2025-12-06 00:18:34.875
-- ensure:hashjoin select * from join_table_1 inner join join_table_2 on join_table_1.id = join_table_2.id;
### 2025-12-06 00:18:34.875
-- sort select * from join_table_1 inner join join_table_2 on join_table_1.id = join_table_2.id;
### 2025-12-06 00:18:34.875
-- ensure:hashjoin*2 Select * from join_table_1 inner join join_table_2 on join_table_1.id=join_table_2.id inner join join_table_3 on join_table_1.id=join_table_3.id;
### 2025-12-06 00:18:34.875
-- sort Select * from join_table_1 inner join join_table_2 on join_table_1.id=join_table_2.id inner join join_table_3 on join_table_1.id=join_table_3.id;
### 2025-12-06 00:18:34.875
-- ensure:hashjoin Select * from join_table_1 inner join join_table_2 on join_table_1.id=join_table_2.id inner join join_table_3 on join_table_1.id<join_table_3.id;
### 2025-12-06 00:18:34.876
-- ensure:nlj Select * from join_table_1 inner join join_table_2 on join_table_1.id=join_table_2.id inner join join_table_3 on join_table_1.id<join_table_3.id;
### 2025-12-06 00:18:34.876
-- sort Select * from join_table_1 inner join join_table_2 on join_table_1.id=join_table_2.id inner join join_table_3 on join_table_1.id<join_table_3.id;
